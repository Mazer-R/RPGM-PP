# Experiment image: Node on ARM64 Linux with a real Canvas 2D library
# (node-canvas, Cairo) and a WebGL implementation (the `gl` package,
# "headless-gl") drawing through Mesa's software OpenGL under a virtual X
# display. It proves the WebGL path works without a browser; it says nothing
# about speed on a real GPU. Game files are mounted at run time.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libjpeg62-turbo libgif7 librsvg2-2 \
      xvfb xauth libgl1-mesa-dri libglx-mesa0 libgl1 libxi6 libxext6 libx11-6 \
      python3 python-is-python3 build-essential pkg-config libxi-dev libglu1-mesa-dev libglew-dev libx11-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/lab
RUN npm install --no-audit --no-fund canvas@3 gl@8
ENV NODE_PATH=/opt/lab/node_modules
USER node
WORKDIR /lab
