# This folder also holds material unrelated to the project. Ignore everything
# at the top level and list what belongs to the repository explicitly.
/*
!/.gitignore
!/README.md
!/LICENSE
!/concepts_brief.md
!/lab/
!/docs/
!/player/

.DS_Store

# Player: derived, large, or copied from the console.
player/build*/
player/sysroot/
player/third_party/v8/
player/third_party/v8-x64/
player/third_party/v8-android/
player/third_party/android-deps/
player/third_party/headers/*/
player/tools/*/logs/
__pycache__/
